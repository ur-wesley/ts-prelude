{
  "name": "@ur-wesley/ts-prelude",
  "version": "0.1.4",
  "description": "Functional prelude for TypeScript — Option, Result, pattern matching, and scope utilities",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "AGENTS.md",
    "llms.txt",
    "README.md",
    ".cursor/skills/ts-prelude"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./result": {
      "types": "./dist/result/index.d.ts",
      "import": "./dist/result/index.js"
    },
    "./option": {
      "types": "./dist/option/index.d.ts",
      "import": "./dist/option/index.js"
    },
    "./match": {
      "types": "./dist/match/index.d.ts",
      "import": "./dist/match/index.js"
    },
    "./pipe": {
      "types": "./dist/pipe/index.d.ts",
      "import": "./dist/pipe/index.js"
    },
    "./data/*": {
      "types": "./dist/data/*.d.ts",
      "import": "./dist/data/*.js"
    },
    "./iter": {
      "types": "./dist/iter/index.d.ts",
      "import": "./dist/iter/index.js"
    },
    "./interop": {
      "types": "./dist/interop/index.d.ts",
      "import": "./dist/interop/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./scope": {
      "types": "./dist/scope/index.d.ts",
      "import": "./dist/scope/index.js"
    },
    "./record": {
      "types": "./dist/record/index.d.ts",
      "import": "./dist/record/index.js"
    },
    "./async": {
      "types": "./dist/async/index.d.ts",
      "import": "./dist/async/index.js"
    },
    "./resource": {
      "types": "./dist/resource/index.d.ts",
      "import": "./dist/resource/index.js"
    },
    "./log": {
      "types": "./dist/log/index.d.ts",
      "import": "./dist/log/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./lazy": {
      "types": "./dist/lazy/index.d.ts",
      "import": "./dist/lazy/index.js"
    },
    "./wire": {
      "types": "./dist/wire/index.d.ts",
      "import": "./dist/wire/index.js"
    }
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "bun check",
    "typecheck:tsc": "tsc --noEmit",
    "lint": "oxlint --type-aware --type-check --tsconfig tsconfig.lint.json",
    "lint:fix": "oxlint --type-aware --type-check --tsconfig tsconfig.lint.json --fix",
    "format": "oxfmt \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.config.ts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.config.ts\"",
    "bundle-check": "bun scripts/bundle-check.ts",
    "verify": "bun run typecheck && bun run format:check && bun run lint && bun run test && bun run build && bun run bundle-check",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "consola": "^3.4.2",
    "neverthrow": "^8.2.0",
    "remeda": "^2.52.0",
    "ts-pattern": "^5.9.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  }
}
